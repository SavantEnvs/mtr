# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── autotools-generated / local build cruft (mayhem/build.sh regenerates these) ──────────────
autom4te.cache/
/configure
/config.h.in
/config.h
/Makefile.in
/Makefile
/aclocal.m4
*.o
*.a
*.so
*.dylib
mtr-dist-version-test/
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
